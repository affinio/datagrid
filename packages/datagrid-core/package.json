{
  "name": "@affino/datagrid-core",
  "version": "0.14.0",
  "author": "Anton Pavlov <a.pavlov@affino.dev>",
  "type": "module",
  "description": "Headless data grid core for Affino UI primitives",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./advanced": {
      "types": "./dist/src/advanced.d.ts",
      "import": "./dist/src/advanced.js"
    },
    "./internal": {
      "types": "./dist/src/internal.d.ts",
      "import": "./dist/src/internal.js"
    },
    "./client-row-store": {
      "types": "./dist/src/client-row-store.d.ts",
      "import": "./dist/src/client-row-store.js"
    },
    "./advanced-client-row-model": {
      "types": "./dist/src/advanced-client-row-model.d.ts",
      "import": "./dist/src/advanced-client-row-model.js"
    },
    "./client-row-projection": {
      "types": "./dist/src/client-row-projection.d.ts",
      "import": "./dist/src/client-row-projection.js"
    },
    "./client-row-projection/model": {
      "types": "./dist/src/client-row-projection/model.d.ts",
      "import": "./dist/src/client-row-projection/model.js"
    },
    "./client-row-projection/basic": {
      "types": "./dist/src/client-row-projection/basic.d.ts",
      "import": "./dist/src/client-row-projection/basic.js"
    },
    "./client-row-projection/filter": {
      "types": "./dist/src/client-row-projection/filter.d.ts",
      "import": "./dist/src/client-row-projection/filter.js"
    },
    "./client-row-projection/sort": {
      "types": "./dist/src/client-row-projection/sort.d.ts",
      "import": "./dist/src/client-row-projection/sort.js"
    },
    "./client-row-projection/sort-cache": {
      "types": "./dist/src/client-row-projection/sort-cache.d.ts",
      "import": "./dist/src/client-row-projection/sort-cache.js"
    },
    "./client-row-projection/pagination": {
      "types": "./dist/src/client-row-projection/pagination.d.ts",
      "import": "./dist/src/client-row-projection/pagination.js"
    },
    "./client-row-projection/visible": {
      "types": "./dist/src/client-row-projection/visible.d.ts",
      "import": "./dist/src/client-row-projection/visible.js"
    },
    "./client-row-projection/group": {
      "types": "./dist/src/client-row-projection/group.d.ts",
      "import": "./dist/src/client-row-projection/group.js"
    },
    "./client-row-projection/pivot": {
      "types": "./dist/src/client-row-projection/pivot.d.ts",
      "import": "./dist/src/client-row-projection/pivot.js"
    },
    "./client-row-projection/aggregate": {
      "types": "./dist/src/client-row-projection/aggregate.d.ts",
      "import": "./dist/src/client-row-projection/aggregate.js"
    },
    "./client-row-projection/comparator-registry": {
      "types": "./dist/src/client-row-projection/comparator-registry.d.ts",
      "import": "./dist/src/client-row-projection/comparator-registry.js"
    }
  },
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b tsconfig.public.json && node ./scripts/fix-esm-specifiers.mjs",
    "type-check": "node ./scripts/type-check.mjs",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:file": "vitest run --config vitest.config.ts",
    "test:contracts": "vitest run --config vitest.config.ts --testNamePattern=\"contract|lifecycle\"",
    "test:regressions": "vitest run --config vitest.config.ts --testNamePattern=\"determinism|stress\"",
    "test:strict-contracts": "vitest run --config vitest.config.ts --testNamePattern=\"contract|lifecycle|property|stress|determinism\"",
    "test:integration": "vitest run --config vitest.config.ts --testNamePattern=\"contract|integration|property|stress\"",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test": "pnpm run type-check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/affinio/datagrid.git",
    "directory": "packages/datagrid-core"
  },
  "homepage": "https://github.com/affinio/datagrid/tree/main/packages/datagrid-core#readme",
  "license": "MIT",
  "keywords": [
    "datagrid",
    "grid",
    "table",
    "engine",
    "headless",
    "core"
  ],
  "dependencies": {
    "@affino/datagrid-format": "workspace:*",
    "@affino/datagrid-formula-engine": "workspace:*",
    "@affino/datagrid-pivot": "workspace:*",
    "@affino/projection-engine": "workspace:*",
    "@affino/datagrid-plugins": "workspace:*"
  },
  "peerDependencies": {},
  "devDependencies": {},
  "bugs": {
    "url": "https://github.com/affinio/datagrid/issues"
  },
  "module": "dist/src/index.js"
}
