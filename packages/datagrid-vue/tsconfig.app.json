{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": true,
    "emitDeclarationOnly": false,
    "noEmit": false,
    "outDir": "./dist",
    "rootDir": "./src/app-layer",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": false,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@affino/datagrid-core": ["../datagrid-core/dist/src/index.d.ts"],
      "@affino/datagrid-core/*": ["../datagrid-core/dist/src/*"],
      "@affino/datagrid-formula-engine": ["../datagrid-formula-engine/dist/index.d.ts"],
      "@affino/datagrid-formula-engine/*": ["../datagrid-formula-engine/dist/*"],
      "@affino/datagrid-chrome": ["../datagrid-chrome/dist/index.d.ts"],
      "@affino/datagrid-chrome/*": ["../datagrid-chrome/dist/*"],
      "@affino/datagrid-gantt": ["../datagrid-gantt/dist/index.d.ts"],
      "@affino/datagrid-gantt/*": ["../datagrid-gantt/dist/*"],
      "@affino/datagrid-orchestration": ["../datagrid-orchestration/dist/src/index.d.ts"],
      "@affino/datagrid-orchestration/*": ["../datagrid-orchestration/dist/src/*"],
      "@affino/datagrid-theme": ["../datagrid-theme/dist/index.d.ts"],
      "@affino/datagrid-theme/*": ["../datagrid-theme/dist/*"],
      "@affino/menu-vue": ["./node_modules/@affino/menu-vue"],
      "@affino/popover-vue": ["./node_modules/@affino/popover-vue"],
      "@affino/datagrid-vue/headless": ["../datagrid-vue/dist/headless/index.d.ts"],
      "@affino/datagrid-vue/headless/*": ["../datagrid-vue/dist/headless/*"],
      "@affino/datagrid-vue/app": ["../datagrid-vue/dist/headless/app/index.d.ts"],
      "@affino/datagrid-vue/app/worker": ["../datagrid-vue/dist/headless/app/worker.d.ts"],
      "@affino/datagrid-vue/app/*": ["../datagrid-vue/dist/headless/app/*"],
      "@affino/datagrid-vue": ["../datagrid-vue/dist/index.d.ts"],
      "@affino/datagrid-vue/*": ["../datagrid-vue/dist/*"]
    }
  },
  "include": ["src/app-layer/**/*.ts", "src/app-layer/**/*.vue", "src/app-layer/**/*.d.ts"],
  "exclude": ["src/app-layer/**/__tests__/**", "src/app-layer/**/*.spec.ts", "src/app-layer/**/*.test.ts"]
}
