{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "paths": {
      "@affino/charts-core": ["../charts-core/dist/index.d.ts"],
      "@affino/charts-vue": ["./src/index.ts"],
      "@affino/charts-vue/*": ["./src/*"]
    }
  },
  "include": ["examples/**/*.ts", "examples/**/*.vue", "src/**/*.d.ts"]
}
